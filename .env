# NCPOR / MoES Seafloor Metal Detection Sensor Configuration
# When false, connects to real backend REST API and live WebSocket
VITE_USE_MOCK_DATA=false

# REST API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket URL for live telemetry streaming
VITE_WS_URL=ws://localhost:8000/ws/telemetry

# Fallback polling interval in milliseconds if WebSocket is unavailable
VITE_POLLING_INTERVAL_MS=3000
