# NCPOR / MoES Seafloor Metal Detection Sensor Configuration
# When true, loads high-fidelity mock dataset and stream simulation
VITE_USE_MOCK_DATA=true

# Provisional REST API Base URL (Provisional — to be confirmed with backend team)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Provisional WebSocket URL for live telemetry streaming
VITE_WS_URL=ws://localhost:8000/ws/telemetry

# Fallback polling interval in milliseconds if WebSocket is unavailable
VITE_POLLING_INTERVAL_MS=3000
